{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tehabish-masrya-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tehabish-db",
    }
  ]
}
